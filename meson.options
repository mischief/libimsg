option('lua', type : 'combo', choices : ['false', 'luajit', 'lua5.3', 'lua5.4', 'lua5.5', 'rock'], value : 'false',
  description : 'Lua for the binding; rock: the headers in lua-incdir, for luarocks')
option('lua-incdir', type : 'string', value : '', description : 'Lua header directory for -Dlua=rock')
option('lua-module-directory', type : 'string', value : '', description : 'override lua C module directory')
option('lua-only', type : 'boolean', value : false)
option('lua-static', type : 'boolean', value : false)

option('docs', type: 'feature', value: 'auto', description: 'build API documentation with ldoc')
